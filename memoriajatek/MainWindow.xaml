<Window x:Class="memoriajatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:memoriajatek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <ListBox x:Name="lbox_meret" d:ItemsSource="{d:SampleData ItemCount=3}" Width="100" HorizontalAlignment="Left" Margin="0,-200,0,0" VerticalAlignment="Center"/>
        <ListBox x:Name="lbox_tema" d:ItemsSource="{d:SampleData ItemCount=3}" Width="100" HorizontalAlignment="Left" Margin="0,100,0,0" VerticalAlignment="Center"/>
        <TextBlock TextWrapping="Wrap" Text="Téma" Width="100" Height="20" HorizontalAlignment="Left" Margin="0,10,0,0"/>

    </Grid>
</Window>
