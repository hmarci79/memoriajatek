<Window x:Class="memoriajatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:memoriajatek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <ListBox x:Name="lbox_meret" d:ItemsSource="{d:SampleData ItemCount=3}" Width="100" HorizontalAlignment="Left" Margin="0,-210,0,0" VerticalAlignment="Center" SelectionChanged="lbox_meret_SelectionChanged"/>
        <ListBox x:Name="lbox_tema" d:ItemsSource="{d:SampleData ItemCount=3}" Width="100" HorizontalAlignment="Left" Margin="0,90,0,0" VerticalAlignment="Center" SelectionChanged="lbox_tema_SelectionChanged"/>
        <TextBlock TextWrapping="Wrap" Text="Téma" Width="100" Height="20" HorizontalAlignment="Left" Margin="0,0,0,0"/>
        <TextBlock TextWrapping="Wrap" Text="Méret" Width="100" Height="20" HorizontalAlignment="Left" Margin="0,-300,0,0"/>
        <Button x:Name="btn_kezdes" Content="Kezdés" Height="40" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="btn_kezdes_Click"/>
        <Grid x:Name="grid_kartyak" Height="360" Width="360" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        </Grid>
    </Grid>
</Window>
